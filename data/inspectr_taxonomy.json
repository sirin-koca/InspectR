{
  "id": "TK.MUNDAT.PolicyScope",
  "label": "TK/MUNDAT InspectR Policy Scope",
  "level": "Root",
  "description": "Six design-time TK/MUNDAT policy rules evaluated by the InspectR PoC",
  "scope": "PoC",
  "children": [
    {
      "id": "TK-001",
      "label": "TK-001 — DPIA checkpoint",
      "level": "Rule",
      "description": "Checks whether elevated-risk personal data processing includes a defined DPIA checkpoint.",
      "rule_id": "TK-001",
      "legal_references": ["GDPR Art. 35"],
      "relationship": "TK/MUNDAT operational proxy",
      "evidence_fields": [
        "pipeline.nodes[*].properties.contains_personal_data",
        "pipeline.nodes[*].properties.contains_special_category_data",
        "pipeline.nodes[*].properties.dpia_checkpoint_defined"
      ],
      "color": "#FF77DC"
    },
    {
      "id": "TK-002",
      "label": "TK-002 — Special-category risk assessment",
      "level": "Rule",
      "description": "Checks whether special-category data processing includes a defined risk-assessment checkpoint.",
      "rule_id": "TK-002",
      "legal_references": ["GDPR Arts. 9 and 35"],
      "relationship": "TK/MUNDAT operational proxy",
      "evidence_fields": [
        "pipeline.nodes[*].properties.contains_special_category_data",
        "pipeline.nodes[*].properties.risk_assessment_checkpoint_defined"
      ],
      "color": "#FDB033"
    },
    {
      "id": "TK-003",
      "label": "TK-003 — Data-sharing agreement",
      "level": "Rule",
      "description": "Checks whether personal-data transfer includes a defined data-sharing agreement checkpoint.",
      "rule_id": "TK-003",
      "legal_references": ["GDPR Arts. 5, 6, and 28"],
      "relationship": "TK/MUNDAT governance operationalisation",
      "evidence_fields": [
        "pipeline.nodes[*].properties.contains_personal_data",
        "pipeline.nodes[*].type",
        "pipeline.nodes[*].properties.data_sharing_agreement_checkpoint_defined"
      ],
      "color": "#2E86AB"
    },
    {
      "id": "TK-004",
      "label": "TK-004 — Data lineage and provenance",
      "level": "Rule",
      "description": "Checks whether integrated datasets identify a planned lineage record.",
      "rule_id": "TK-004",
      "legal_references": ["GDPR Arts. 5(2) and 30"],
      "relationship": "TK/MUNDAT traceability operationalisation",
      "evidence_fields": [
        "pipeline.nodes[*].type",
        "pipeline.nodes[*].properties.lineage_record_defined"
      ],
      "color": "#62C370"
    },
    {
      "id": "TK-005",
      "label": "TK-005 — Purpose compatibility review",
      "level": "Rule",
      "description": "Checks whether purpose compatibility is declared in the design or requires human review.",
      "rule_id": "TK-005",
      "legal_references": ["GDPR Arts. 5(1)(b) and 6(4)"],
      "relationship": "TK/MUNDAT governance safeguard",
      "evidence_fields": [
        "pipeline.nodes[*].properties.purpose_compatibility_declared"
      ],
      "color": "#A66DD4"
    },
    {
      "id": "TK-006",
      "label": "TK-006 — Complete sharing safeguards",
      "level": "Rule",
      "description": "Checks DPIA, risk, agreement, recipient, and encrypted-transfer safeguards.",
      "rule_id": "TK-006",
      "legal_references": ["GDPR Arts. 25 and 32"],
      "relationship": "TK/MUNDAT sharing safeguard",
      "evidence_fields": [
        "dpia_check.properties.dpia_checkpoint_defined",
        "dpia_check.properties.risk_assessment_checkpoint_defined",
        "sharing_assessment.properties.data_sharing_agreement_checkpoint_defined",
        "sharing_assessment.properties.recipient_approval_checkpoint_defined",
        "share_dataset.properties.encryption_in_transit_configured"
      ],
      "color": "#E76F51"
    }
  ]
}
