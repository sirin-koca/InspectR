{
  "id": "TK.MUNDAT.PolicyScope",
  "label": "TK/MUNDAT InspectR Policy Scope",
  "level": "Root",
  "description": "Six design-time TK/MUNDAT policy rules evaluated by the InspectR PoC",
  "scope": "PoC",
  "children": [
    {
      "id": "TK-001",
      "label": "TK-001 — DPIA requirement and completion",
      "level": "Rule",
      "description": "Checks whether elevated-risk personal data processing requires and documents a completed DPIA.",
      "rule_id": "TK-001",
      "legal_references": ["GDPR Art. 35"],
      "relationship": "TK/MUNDAT operational proxy",
      "evidence_fields": [
        "pipeline.nodes[*].properties.contains_personal_data",
        "pipeline.nodes[*].properties.contains_special_category_data",
        "pipeline.nodes[*].properties.dpia_completed"
      ],
      "color": "#FF77DC"
    },
    {
      "id": "TK-002",
      "label": "TK-002 — Special-category risk assessment",
      "level": "Rule",
      "description": "Checks whether special-category data processing has a completed risk assessment.",
      "rule_id": "TK-002",
      "legal_references": ["GDPR Arts. 9 and 35"],
      "relationship": "TK/MUNDAT operational proxy",
      "evidence_fields": [
        "pipeline.nodes[*].properties.contains_special_category_data",
        "pipeline.nodes[*].properties.risk_assessment_completed"
      ],
      "color": "#FDB033"
    },
    {
      "id": "TK-003",
      "label": "TK-003 — Data-sharing agreement",
      "level": "Rule",
      "description": "Checks whether personal-data transfer is supported by a declared data-sharing agreement.",
      "rule_id": "TK-003",
      "legal_references": ["GDPR Arts. 5, 6, and 28"],
      "relationship": "TK/MUNDAT governance operationalisation",
      "evidence_fields": [
        "pipeline.nodes[*].properties.contains_personal_data",
        "pipeline.nodes[*].type",
        "pipeline.nodes[*].properties.data_sharing_agreement_exists"
      ],
      "color": "#2E86AB"
    },
    {
      "id": "TK-004",
      "label": "TK-004 — Data lineage and provenance",
      "level": "Rule",
      "description": "Checks whether integrated datasets declare available lineage.",
      "rule_id": "TK-004",
      "legal_references": ["GDPR Arts. 5(2) and 30"],
      "relationship": "TK/MUNDAT traceability operationalisation",
      "evidence_fields": [
        "pipeline.nodes[*].type",
        "pipeline.nodes[*].properties.lineage_available"
      ],
      "color": "#62C370"
    },
    {
      "id": "TK-005",
      "label": "TK-005 — Purpose compatibility review",
      "level": "Rule",
      "description": "Checks whether purpose compatibility is explicitly verified or requires human review.",
      "rule_id": "TK-005",
      "legal_references": ["GDPR Arts. 5(1)(b) and 6(4)"],
      "relationship": "TK/MUNDAT governance safeguard",
      "evidence_fields": [
        "pipeline.nodes[*].properties.purpose_compatible"
      ],
      "color": "#A66DD4"
    },
    {
      "id": "TK-006",
      "label": "TK-006 — Complete sharing safeguards",
      "level": "Rule",
      "description": "Checks DPIA, risk, agreement, recipient, and encrypted-transfer safeguards.",
      "rule_id": "TK-006",
      "legal_references": ["GDPR Arts. 25 and 32"],
      "relationship": "TK/MUNDAT sharing safeguard",
      "evidence_fields": [
        "dpia_check.properties.dpia_completed",
        "dpia_check.properties.risk_assessment_completed",
        "sharing_assessment.properties.data_sharing_agreement_exists",
        "sharing_assessment.properties.recipient_approved",
        "share_dataset.properties.encrypted_in_transit"
      ],
      "color": "#E76F51"
    }
  ]
}
