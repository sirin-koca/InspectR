{
  "pipeline": {
    "id": "tk_mundat_data_sharing_v2",
    "name": "Municipal Data Sharing Workflow",
    "description": "Compliance-enriched design-time blueprint for InspectR PoC",
    "nodes": [
      {
        "id": "request",
        "type": "request_intake",
        "properties": {
          "request_id": "REQ-2026-MUNDAT",
          "requester_identity": "academic_research_group",
          "purpose_specified": "sickleave_trend_analysis",
          "legal_basis_documented": "explicit_consent_contract"
        }
      },
      {
        "id": "classify_request",
        "type": "assessment",
        "properties": {
          "personal_data_expected": true,
          "special_category_data": true,
          "children_data": false,
          "purpose_defined": true
        }
      },
      {
        "id": "dpia_check",
        "type": "compliance_gate",
        "properties": {
          "dpia_required": true,
          "dpia_completed": true,
          "risk_assessment_completed": true,
          "evidence_required": true
        }
      },
      {
        "id": "health_services",
        "type": "data_source",
        "properties": {
          "contains_personal_data": true,
          "contains_special_category_data": true,
          "data_owner_defined": "municipal_hr_director",
          "schema_fields": [
            { "name": "employee_id", "type": "string", "is_pii": true, "masking_strategy": "pseudonymise" },
            { "name": "sick_leave_reasons", "type": "string", "is_pii": true, "masking_strategy": "none" },
            { "name": "department_code", "type": "string", "is_pii": false, "masking_strategy": "none" }
          ],
          "infrastructure_config": {
            "storage_provider": "local_municipal_server",
            "encryption_at_rest": true,
            "retention_policy": {
              "ttl_days": 30,
              "auto_purge_enabled": true
            }
          }
        }
      },
      {
        "id": "citizen_registry",
        "type": "data_source",
        "properties": {
          "contains_personal_data": true,
          "contains_special_category_data": false,
          "data_owner_defined": "registry_service_owner",
          "schema_fields": [
            { "name": "national_id", "type": "string", "is_pii": true, "masking_strategy": "hash_sha256" },
            { "name": "birth_year", "type": "integer", "is_pii": false, "masking_strategy": "none" }
          ],
          "infrastructure_config": {
            "storage_provider": "secure_dataspace_bucket",
            "encryption_at_rest": false,
            "retention_policy": {
              "ttl_days": 90,
              "auto_purge_enabled": true
            }
          }
        }
      },
      {
        "id": "extract_data",
        "type": "data_processing",
        "properties": {
          "purpose_limited": true,
          "data_minimisation_applied": true,
          "logging_enabled": true
        }
      },
      {
        "id": "integrate_dataset",
        "type": "data_integration",
        "properties": {
          "lineage_available": true,
          "provenance_recorded": true,
          "schema_documented": true
        }
      },
      {
        "id": "anonymisation",
        "type": "privacy_control",
        "properties": {
          "anonymisation_applied": true,
          "reidentification_risk_assessed": true
        }
      },
      {
        "id": "sharing_assessment",
        "type": "compliance_gate",
        "properties": {
          "purpose_compatible": true,
          "contract_available": true,
          "recipient_approved": true,
          "data_sharing_agreement_exists": true
        }
      },
      {
        "id": "share_dataset",
        "type": "data_transfer",
        "properties": {
          "encrypted_in_transit": true,
          "approved_recipient": true,
          "audit_trail_enabled": true,
          "sink_destination": "trondheim_open_data_portal"
        }
      }
    ],
    "connections": [
      { "from": "request", "to": "classify_request", "flow_type": "control" },
      { "from": "classify_request", "to": "dpia_check", "flow_type": "control" },
      { "from": "dpia_check", "to": "citizen_registry", "flow_type": "authorisation" },
      { "from": "dpia_check", "to": "health_services", "flow_type": "authorisation" },
      { "from": "citizen_registry", "to": "extract_data", "flow_type": "data" },
      { "from": "health_services", "to": "extract_data", "flow_type": "data" },
      { "from": "extract_data", "to": "integrate_dataset", "flow_type": "data" },
      { "from": "integrate_dataset", "to": "anonymisation", "flow_type": "data" },
      { "from": "anonymisation", "to": "sharing_assessment", "flow_type": "data" },
      { "from": "sharing_assessment", "to": "share_dataset", "flow_type": "approval" }
    ]
  }
}
