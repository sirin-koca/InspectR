diff --git a/policies/tk/TK-R1.rego b/policies/tk/TK-R1.rego
new file mode 100644
index 0000000..786c490
--- /dev/null
+++ b/policies/tk/TK-R1.rego
@@ -0,0 +1,189 @@
+#
+# TK-R1 : DPIA and risk-assessment checkpoint for special-category data
+#
+# Replaces TK-001 (DPIA checkpoint) and TK-002 (risk-assessment checkpoint),
+# which had the same trigger.
+#
+# Requirement  TK need "DPIA / risk assessment"; MUNDAT activity
+#              "perform DPIA and risk assessment"; Sickleave dataset.
+# Legal basis  GDPR Art. 35(1), Art. 35(3)(b) where applicable; Art. 9.
+# Trigger      Any data_source declares contains_special_category_data: true.
+# Controls     One compliance_gate declares both
+#              dpia_checkpoint_defined: true and
+#              risk_assessment_checkpoint_defined: true.
+# Evidence     Manually declared (class M). inLUMEN does not export it today.
+#
+# Decision table (evaluated top to bottom, first match wins)
+#   1  no source declares true, and a source flag is missing/invalid
+#      or there are no data sources                         -> UNKNOWN
+#   2  every source declares false                           -> NOT_APPLICABLE
+#   3  trigger true, no compliance_gate in the design        -> FAIL
+#   4  trigger true, a gate declares a control false         -> FAIL
+#   5  trigger true, one gate declares both controls true    -> PASS
+#   6  trigger true, controls missing/invalid                -> UNKNOWN
+#   7  anything else (should be unreachable)                 -> ERROR
+#
+package inspectr.tk.r1
+
+import data.inspectr.lib
+import rego.v1
+
+rule_id := "TK-R1"
+
+title := "DPIA and risk-assessment checkpoint for special-category data"
+
+legal_reference := "GDPR Art. 35(1), Art. 35(3)(b), Art. 9"
+
+trigger_field := "contains_special_category_data"
+
+control_fields := ["dpia_checkpoint_defined", "risk_assessment_checkpoint_defined"]
+
+sources := lib.nodes_of_type("data_source")
+
+gates := lib.nodes_of_type("compliance_gate")
+
+# ---------- trigger ----------
+
+trigger_true if {
+	some s in sources
+	lib.is_true(s, trigger_field)
+}
+
+unusable_sources := [s.id | some s in sources; lib.not_usable(s, trigger_field)]
+
+trigger_unknown if {
+	not trigger_true
+	count(unusable_sources) > 0
+}
+
+trigger_unknown if {
+	not trigger_true
+	count(sources) == 0
+}
+
+trigger_false if {
+	not trigger_true
+	count(sources) > 0
+	count(unusable_sources) == 0
+}
+
+# ---------- controls ----------
+
+# Gates that carry at least one of the two control fields.
+relevant_gate_ids := {g.id | some g in gates; some f in control_fields; lib.has_field(g, f)}
+
+relevant_gates := [g | some g in gates; g.id in relevant_gate_ids]
+
+control_false if {
+	some g in relevant_gates
+	some f in control_fields
+	lib.is_false(g, f)
+}
+
+passing_gate_ids := [g.id |
+	some g in relevant_gates
+	every f in control_fields {
+		lib.is_true(g, f)
+	}
+]
+
+# ---------- evidence ----------
+
+trigger_evidence := [lib.evidence(s, trigger_field, "boolean", "Declares whether this source processes special-category data (GDPR Art. 9).") |
+	some s in sources
+]
+
+# If no gate carries the fields, show all gates so the reader sees where they are missing.
+gates_to_show := relevant_gates if count(relevant_gates) > 0
+
+else := gates
+
+control_evidence := [lib.evidence(g, f, true, "A compliance gate must declare this checkpoint before sensitive processing.") |
+	some g in gates_to_show
+	some f in control_fields
+]
+
+report(status, row, reason, remedy, ev) := {
+	"rule": rule_id,
+	"title": title,
+	"status": status,
+	"decision_row": row,
+	"legal_reference": legal_reference,
+	"reason": reason,
+	"evidence": {
+		"input_evidence": ev,
+		"derived_evidence": {
+			"special_category_trigger": trigger_state,
+			"sources_with_unusable_flag": unusable_sources,
+			"compliance_gates": [g.id | some g in gates],
+			"gates_with_both_controls": passing_gate_ids,
+		},
+	},
+	"remedy": remedy,
+}
+
+trigger_state := "true" if trigger_true
+
+else := "unknown" if trigger_unknown
+
+else := "false"
+
+# ---------- decision ----------
+
+default result := {
+	"rule": "TK-R1",
+	"title": "DPIA and risk-assessment checkpoint for special-category data",
+	"status": "ERROR",
+	"decision_row": 7,
+	"legal_reference": "GDPR Art. 35(1), Art. 35(3)(b), Art. 9",
+	"reason": "No decision-table row matched. This is a defect in the rule, not a finding about the blueprint.",
+	"evidence": {"input_evidence": [], "derived_evidence": {}},
+	"remedy": "Report to the InspectR developer: add a test for this input and close the gap in TK-R1.",
+}
+
+result := report(
+	"UNKNOWN", 1,
+	"InspectR cannot decide whether special-category data is processed: no data source declares it as true, and the flag is missing or invalid on at least one source (or no data sources are declared).",
+	"Declare contains_special_category_data as true or false on every data_source node.",
+	trigger_evidence,
+) if {
+	trigger_unknown
+} else := report(
+	"NOT_APPLICABLE", 2,
+	"Every data source declares contains_special_category_data: false, so a DPIA and risk assessment are not triggered by this rule.",
+	null,
+	trigger_evidence,
+) if {
+	trigger_false
+} else := report(
+	"FAIL", 3,
+	"Special-category data is processed, but the design contains no compliance gate for the DPIA and risk assessment.",
+	"Add a compliance_gate before sensitive processing that declares dpia_checkpoint_defined: true and risk_assessment_checkpoint_defined: true.",
+	trigger_evidence,
+) if {
+	trigger_true
+	count(gates) == 0
+} else := report(
+	"FAIL", 4,
+	"Special-category data is processed, but a compliance gate declares the DPIA or risk-assessment checkpoint as not defined.",
+	"Define the missing checkpoint in the design and set the field to true.",
+	array.concat(trigger_evidence, control_evidence),
+) if {
+	trigger_true
+	control_false
+} else := report(
+	"PASS", 5,
+	sprintf("Special-category data is processed and gate '%s' declares both a DPIA and a risk-assessment checkpoint.", [passing_gate_ids[0]]),
+	null,
+	array.concat(trigger_evidence, control_evidence),
+) if {
+	trigger_true
+	count(passing_gate_ids) > 0
+} else := report(
+	"UNKNOWN", 6,
+	"Special-category data is processed, but no compliance gate declares both checkpoints as booleans. The fields are missing or invalid.",
+	"Declare dpia_checkpoint_defined and risk_assessment_checkpoint_defined as true or false on the compliance gate.",
+	array.concat(trigger_evidence, control_evidence),
+) if {
+	trigger_true
+}
diff --git a/policies/tk/TK-R2.rego b/policies/tk/TK-R2.rego
new file mode 100644
index 0000000..b2752fc
--- /dev/null
+++ b/policies/tk/TK-R2.rego
@@ -0,0 +1,103 @@
+#
+# TK-R2 : Lineage record for integrated data
+#
+# Replaces TK-004.
+#
+# Requirement  TK needs "metadata and lineage" and "Traceability: document
+#              data provenance and processing"; MUNDAT activity "integrate data".
+# Legal basis  GDPR Art. 5(2) (accountability); Art. 30 where applicable.
+# Trigger      The design contains a node with type: data_integration.
+# Control      Every such node declares lineage_record_defined: true.
+# Evidence     Declared today; could be derived from inLUMEN runs (class D).
+#
+# Decision table (evaluated top to bottom, first match wins)
+#   1  (input has no pipeline.nodes: rejected by evaluator.py before OPA)
+#   2  no data_integration node                              -> NOT_APPLICABLE
+#   3  an integration node declares the control false        -> FAIL
+#   4  an integration node has the control missing/invalid   -> UNKNOWN
+#   5  every integration node declares the control true      -> PASS
+#   6  anything else (should be unreachable)                 -> ERROR
+#
+# Known limit: a raw inLUMEN export uses "kind", not "type", so it has no
+# data_integration node and returns NOT_APPLICABLE. That is a correct reading
+# of the input but not of the pipeline; the planned adapter (RQ2) fixes it.
+#
+package inspectr.tk.r2
+
+import data.inspectr.lib
+import rego.v1
+
+rule_id := "TK-R2"
+
+title := "Lineage record for integrated data"
+
+legal_reference := "GDPR Art. 5(2), Art. 30"
+
+control_field := "lineage_record_defined"
+
+integrations := lib.nodes_of_type("data_integration")
+
+false_ids := [n.id | some n in integrations; lib.is_false(n, control_field)]
+
+unusable_ids := [n.id | some n in integrations; lib.not_usable(n, control_field)]
+
+control_evidence := [lib.evidence(n, control_field, true, "An integration step must declare a lineage record so the combined dataset is traceable to its sources.") |
+	some n in integrations
+]
+
+report(status, row, reason, remedy) := {
+	"rule": rule_id,
+	"title": title,
+	"status": status,
+	"decision_row": row,
+	"legal_reference": legal_reference,
+	"reason": reason,
+	"evidence": {
+		"input_evidence": control_evidence,
+		"derived_evidence": {
+			"integration_nodes": [n.id | some n in integrations],
+			"nodes_with_control_false": false_ids,
+			"nodes_with_control_unusable": unusable_ids,
+		},
+	},
+	"remedy": remedy,
+}
+
+default result := {
+	"rule": "TK-R2",
+	"title": "Lineage record for integrated data",
+	"status": "ERROR",
+	"decision_row": 6,
+	"legal_reference": "GDPR Art. 5(2), Art. 30",
+	"reason": "No decision-table row matched. This is a defect in the rule, not a finding about the blueprint.",
+	"evidence": {"input_evidence": [], "derived_evidence": {}},
+	"remedy": "Report to the InspectR developer: add a test for this input and close the gap in TK-R2.",
+}
+
+result := report(
+	"NOT_APPLICABLE", 2,
+	"The design declares no data_integration node, so no lineage record is required by this rule.",
+	null,
+) if {
+	count(integrations) == 0
+} else := report(
+	"FAIL", 3,
+	sprintf("Integration step(s) %v declare that no lineage record is defined.", [false_ids]),
+	"Define a catalogue-backed lineage record for each listed integration node and set lineage_record_defined: true.",
+) if {
+	count(false_ids) > 0
+} else := report(
+	"UNKNOWN", 4,
+	sprintf("Integration step(s) %v do not declare lineage_record_defined as a boolean, so InspectR cannot decide.", [unusable_ids]),
+	"Declare lineage_record_defined as true or false on each listed integration node.",
+) if {
+	count(unusable_ids) > 0
+} else := report(
+	"PASS", 5,
+	sprintf("All %d integration step(s) declare a lineage record.", [count(integrations)]),
+	null,
+) if {
+	every n in integrations {
+		lib.is_true(n, control_field)
+	}
+}
diff --git a/policies/tk/TK-R3.rego b/policies/tk/TK-R3.rego
new file mode 100644
index 0000000..9c47996
--- /dev/null
+++ b/policies/tk/TK-R3.rego
@@ -0,0 +1,167 @@
+#
+# TK-R3 : Purpose compatibility before sharing personal data
+#
+# Replaces TK-005.
+#
+# Requirement  Requests from researchers, companies and other consumers who
+#              want data for new purposes; TK need "Lawfulness".
+# Legal basis  GDPR Art. 5(1)(b) (purpose limitation), Art. 6(4) (compatibility).
+# Trigger      A data_transfer node exists AND some data_source declares
+#              contains_personal_data: true.
+# Control      purpose_compatibility_declared on a compliance_gate.
+#              Gates that do not carry the field are ignored.
+# Evidence     Legal judgement (class H): can be declared, never derived.
+#              There is deliberately no PASS: the best outcome is HUMAN.
+#
+# Decision table (evaluated top to bottom, first match wins)
+#   1  transfer exists, no source declares personal data true, and a
+#      source flag is missing/invalid or there are no sources -> UNKNOWN
+#   2  no transfer node, or every source declares false       -> NOT_APPLICABLE
+#   3  applies, a gate declares the control false             -> FAIL
+#   4  applies, no gate carries the field, or it is invalid   -> UNKNOWN
+#   5  applies, every gate carrying the field declares true   -> HUMAN
+#   6  anything else (should be unreachable)                  -> ERROR
+#
+package inspectr.tk.r3
+
+import data.inspectr.lib
+import rego.v1
+
+rule_id := "TK-R3"
+
+title := "Purpose compatibility before sharing personal data"
+
+legal_reference := "GDPR Art. 5(1)(b), Art. 6(4)"
+
+trigger_field := "contains_personal_data"
+
+control_field := "purpose_compatibility_declared"
+
+sources := lib.nodes_of_type("data_source")
+
+transfers := lib.nodes_of_type("data_transfer")
+
+gates := lib.nodes_of_type("compliance_gate")
+
+# ---------- trigger ----------
+
+personal_data_true if {
+	some s in sources
+	lib.is_true(s, trigger_field)
+}
+
+unusable_sources := [s.id | some s in sources; lib.not_usable(s, trigger_field)]
+
+transfer_exists if count(transfers) > 0
+
+applies if {
+	transfer_exists
+	personal_data_true
+}
+
+trigger_unknown if {
+	transfer_exists
+	not personal_data_true
+	count(unusable_sources) > 0
+}
+
+trigger_unknown if {
+	transfer_exists
+	count(sources) == 0
+}
+
+# ---------- control ----------
+
+carrying_gates := [g | some g in gates; lib.has_field(g, control_field)]
+
+false_gate_ids := [g.id | some g in carrying_gates; lib.is_false(g, control_field)]
+
+unusable_gate_ids := [g.id | some g in carrying_gates; lib.not_usable(g, control_field)]
+
+# ---------- evidence ----------
+
+trigger_evidence := array.concat(
+	[{
+		"selector": "pipeline.nodes[type==\"data_transfer\"]",
+		"observed": [t.id | some t in transfers],
+		"expected": "at least one node, if data leaves the municipality",
+		"condition": "A data_transfer node means data is shared with another party.",
+	}],
+	[lib.evidence(s, trigger_field, "boolean", "Declares whether this source processes personal data.") | some s in sources],
+)
+
+control_evidence := [lib.evidence(g, control_field, true, "The design must declare that purpose compatibility was assessed before sharing.") |
+	some g in carrying_gates
+]
+
+report(status, row, reason, remedy) := {
+	"rule": rule_id,
+	"title": title,
+	"status": status,
+	"decision_row": row,
+	"legal_reference": legal_reference,
+	"reason": reason,
+	"evidence": {
+		"input_evidence": array.concat(trigger_evidence, control_evidence),
+		"derived_evidence": {
+			"transfer_nodes": [t.id | some t in transfers],
+			"sources_with_unusable_flag": unusable_sources,
+			"gates_carrying_control": [g.id | some g in carrying_gates],
+			"gates_with_control_false": false_gate_ids,
+		},
+	},
+	"remedy": remedy,
+}
+
+# ---------- decision ----------
+
+default result := {
+	"rule": "TK-R3",
+	"title": "Purpose compatibility before sharing personal data",
+	"status": "ERROR",
+	"decision_row": 6,
+	"legal_reference": "GDPR Art. 5(1)(b), Art. 6(4)",
+	"reason": "No decision-table row matched. This is a defect in the rule, not a finding about the blueprint.",
+	"evidence": {"input_evidence": [], "derived_evidence": {}},
+	"remedy": "Report to the InspectR developer: add a test for this input and close the gap in TK-R3.",
+}
+
+result := report(
+	"UNKNOWN", 1,
+	"Data is transferred, but InspectR cannot tell whether it is personal data: no source declares it as true, and the flag is missing or invalid on at least one source (or no data sources are declared).",
+	"Declare contains_personal_data as true or false on every data_source node.",
+) if {
+	trigger_unknown
+} else := report(
+	"NOT_APPLICABLE", 2,
+	"No personal data leaves the municipality in this design (no data_transfer node, or every source declares contains_personal_data: false).",
+	null,
+) if {
+	not applies
+} else := report(
+	"FAIL", 3,
+	sprintf("Personal data is shared, but gate(s) %v declare that purpose compatibility was not assessed.", [false_gate_ids]),
+	"Assess purpose compatibility (GDPR Art. 6(4)) before sharing and set purpose_compatibility_declared: true on the gate.",
+) if {
+	count(false_gate_ids) > 0
+} else := report(
+	"UNKNOWN", 4,
+	"Personal data is shared, but no compliance gate declares purpose_compatibility_declared as a boolean.",
+	"Add purpose_compatibility_declared (true or false) to the sharing compliance gate.",
+) if {
+	count(carrying_gates) == 0
+} else := report(
+	"UNKNOWN", 4,
+	sprintf("Gate(s) %v declare purpose_compatibility_declared with a non-boolean value.", [unusable_gate_ids]),
+	"Set purpose_compatibility_declared to true or false.",
+) if {
+	count(unusable_gate_ids) > 0
+} else := report(
+	"HUMAN", 5,
+	"The design declares a purpose-compatibility assessment before sharing. Compatibility is a legal judgement, so a legal or domain expert must confirm it.",
+	"Have a legal or domain expert confirm the purpose-compatibility assessment (GDPR Art. 6(4)).",
+) if {
+	every g in carrying_gates {
+		lib.is_true(g, control_field)
+	}
+}
diff --git a/policies/tk/lib.rego b/policies/tk/lib.rego
new file mode 100644
index 0000000..8f09497
--- /dev/null
+++ b/policies/tk/lib.rego
@@ -0,0 +1,44 @@
+#
+# InspectR shared helpers (TK rule set v2)
+#
+# Every rule reads blueprint facts through these helpers so that
+# "absent", "null" and "wrong type" are handled the same way everywhere.
+#
+package inspectr.lib
+
+import rego.v1
+
+# Marker shown as the observed value when a field is not in the blueprint.
+absent := "<absent>"
+
+# All nodes of the blueprint. Input structure is validated in evaluator.py,
+# so an empty list here only occurs for a blueprint with no nodes.
+nodes := object.get(object.get(input, "pipeline", {}), "nodes", [])
+
+nodes_of_type(t) := [n | some n in nodes; n.type == t]
+
+props(node) := object.get(node, "properties", {})
+
+# Observed value of a property, or the absent marker.
+observed(node, field) := object.get(props(node), field, absent)
+
+has_field(node, field) if {
+	object.get(props(node), field, absent) != absent
+}
+
+# A fact is usable only if it is a real JSON boolean.
+# Missing, null, "true", 1 etc. are not usable evidence.
+is_true(node, field) if props(node)[field] == true
+
+is_false(node, field) if props(node)[field] == false
+
+not_usable(node, field) if not is_boolean(object.get(props(node), field, absent))
+
+selector(node, field) := sprintf("pipeline.nodes[id==\"%s\"].properties.%s", [node.id, field])
+
+evidence(node, field, expected, condition) := {
+	"selector": selector(node, field),
+	"observed": observed(node, field),
+	"expected": expected,
+	"condition": condition,
+}
